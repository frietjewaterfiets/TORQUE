<Window x:Class="TORQUE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:TORQUE.Controls"
        xmlns:infrastructure="clr-namespace:TORQUE.Infrastructure"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="{Binding AppDisplayName}"
        Width="1201"
        Height="708"
        MinWidth="900"
        MinHeight="531"
        Icon="{Binding AppWindowIconSource}"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        WindowStartupLocation="CenterScreen"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <infrastructure:FileImageSourceConverter x:Key="FileImageSourceConverter" />

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#242424" />
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#1D1D1D" />
        <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#191919" />
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#111111" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#484848" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#404040" />
        <SolidColorBrush x:Key="MutedBrush" Color="#EC5E27" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EC5E27" />

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter Property="Background" Value="#353535" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseHeaderButtonStyle"
               BasedOn="{StaticResource HeaderButtonStyle}"
               TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                    <Setter Property="Background" Value="#C42B1C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButtonStyle"
               BasedOn="{StaticResource PrimaryActionButtonStyle}"
               TargetType="Button">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Background" Value="#1C1C1C" />
            <Setter Property="BorderBrush" Value="#5A5A5A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#262626" />
                                <Setter Property="BorderBrush" Value="#6D6D6D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorTileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DropSurfaceButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      RecognizesAccessKey="True" />

                                    <TextBlock Grid.Column="1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="12"
                                               Text="▼" />
                                </Grid>
                            </Border>

                            <ToggleButton x:Name="ToggleButton"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Style="{StaticResource ComboBoxToggleButtonStyle}" />

                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpeedChipButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Viewbox Stretch="Uniform">
    <Grid Width="1365"
          Height="805"
          Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border Margin="0,0,138,0"
                    Background="Transparent"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="0,2,0,0"
                  IsHitTestVisible="False">
                <Image Height="32"
                       Source="{Binding HeaderLogoPath, Converter={StaticResource FileImageSourceConverter}}"
                       SnapsToDevicePixels="True"
                       UseLayoutRounding="True"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Stretch="Uniform"
                       Visibility="{Binding HasHeaderLogo, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                           FontFamily="Arial Black"
                           FontSize="26"
                           Text="{Binding AppDisplayName}"
                           Visibility="{Binding HasNoHeaderLogo, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Button Content="&#xE921;"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource HeaderButtonStyle}" />
                <Button Content="&#xE922;"
                        Click="MaximizeRestoreButton_Click"
                        Style="{StaticResource HeaderButtonStyle}" />
                <Button Content="&#xE8BB;"
                        Click="CloseButton_Click"
                        Style="{StaticResource CloseHeaderButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              Margin="34,18,34,34">
            <Button HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="OptionsButton_Click"
                    Foreground="{DynamicResource MutedBrush}"
                    Panel.ZIndex="2"
                    Visibility="{Binding IsLandingView, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource GhostButtonStyle}">
                OPTIONS
            </Button>

            <Button HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="BackToLandingButton_Click"
                    Foreground="{DynamicResource MutedBrush}"
                    Panel.ZIndex="2"
                    Visibility="{Binding IsEditorView, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource GhostButtonStyle}">
                CANCEL
            </Button>

            <Border Margin="0,34,0,0"
                    Visibility="{Binding IsLandingView, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="Transparent">
                <Grid>
                    <Button Width="1080"
                            Height="458"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="ImportFilesButton_Click"
                            Style="{StaticResource DropSurfaceButtonStyle}">
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="4"
                                CornerRadius="12">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontFamily="Arial Black"
                                           FontSize="38"
                                           Text="DRAG &amp; DROP / CLICK TO SELECT FILES"
                                           TextAlignment="Center" />
                                <TextBlock Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontFamily="Arial Black"
                                           FontSize="11"
                                           MaxWidth="860"
                                           Text="{Binding LandingExportSummary, Mode=OneWay}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>
            </Border>

            <Grid Margin="0,34,0,0"
                  Visibility="{Binding IsEditorView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="404" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Margin="0,0,0,16"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontFamily="Arial Black"
                               FontSize="56"
                               LineHeight="50"
                               Text="{Binding EditorTitle}"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,0,0,34"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Text="{Binding LoadedCountLabel}" />

                    <StackPanel Visibility="{Binding IsStandardFormatEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Text="CONVERT ALL TO:" />

                        <ComboBox Margin="0,10,0,22"
                                  ItemsSource="{Binding AvailableFormats}"
                                  SelectedItem="{Binding SelectedOutputFormat}"
                                  Style="{StaticResource DarkComboBoxStyle}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsPdfEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Text="CONVERT / MODIFY" />

                        <ComboBox Margin="0,10,0,22"
                                  DisplayMemberPath="Label"
                                  ItemsSource="{Binding PdfActionOptions}"
                                  SelectedItem="{Binding SelectedPdfAction}"
                                  Style="{StaticResource DarkComboBoxStyle}" />
                    </StackPanel>

                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Text="OUTPUT FOLDER" />

                    <ComboBox x:Name="OutputTargetComboBox"
                              Margin="0,10,0,24"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding OutputTargetOptions}"
                              SelectedItem="{Binding SelectedOutputTarget}"
                              SelectionChanged="OutputTargetComboBox_SelectionChanged"
                              Style="{StaticResource DarkComboBoxStyle}" />

                    <StackPanel Visibility="{Binding IsImageEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Text="COMPRESSION" />
                            <TextBlock Grid.Column="1"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Text="{Binding CompressionLabel}" />
                        </Grid>

                        <Slider Minimum="0"
                                Maximum="100"
                                TickFrequency="5"
                                IsSnapToTickEnabled="False"
                                Value="{Binding ImageCompressionPercent}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsVideoEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Text="LOWER RESOLUTION" />
                            <TextBlock Grid.Column="1"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Text="{Binding ResolutionLabel}" />
                        </Grid>

                        <Slider Minimum="1"
                                Maximum="4"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding VideoResolutionDivisor}" />
                    </StackPanel>

                    <Button Margin="0,24,0,14"
                            Click="LetsGoButton_Click"
                            Content="LETS GO!"
                            Style="{StaticResource PrimaryActionButtonStyle}" />

                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="13"
                               Text="Drop more files onto the window to add them to this batch."
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,12,0,0"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="13"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <Grid Grid.Column="2">
                    <ScrollViewer Visibility="{Binding IsImageOverviewVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MediaItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,18,18"
                                            Click="ImageTileButton_Click"
                                            Style="{StaticResource EditorTileButtonStyle}"
                                            Tag="{Binding}">
                                        <Border Width="184"
                                                Height="184"
                                                Background="#2B2B2B"
                                                CornerRadius="4">
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource FileImageSourceConverter}}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Visibility="{Binding IsImageCropVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Margin="0,0,0,10"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Margin="0,0,20,0"
                                    Click="CancelTrimButton_Click"
                                    Content="RESET"
                                    Style="{StaticResource GhostButtonStyle}" />
                            <Button Click="DoneTrimButton_Click"
                                    Content="DONE"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Style="{StaticResource GhostButtonStyle}" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Height="430"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="8">
                            <Grid Margin="14">
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="{Binding SelectedMediaItem.EditorCanvasWidth}"
                                          Height="{Binding SelectedMediaItem.EditorCanvasHeight}">
                                        <Image Source="{Binding SelectedMediaItem.SourcePath, Converter={StaticResource FileImageSourceConverter}}"
                                               Stretch="Fill" />
                                        <controls:CropSelector BottomRatio="{Binding SelectedMediaItem.CropBottomRatio, Mode=TwoWay}"
                                                               LeftRatio="{Binding SelectedMediaItem.CropLeftRatio, Mode=TwoWay}"
                                                               RightRatio="{Binding SelectedMediaItem.CropRightRatio, Mode=TwoWay}"
                                                               TopRatio="{Binding SelectedMediaItem.CropTopRatio, Mode=TwoWay}" />
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2"
                              Margin="0,18,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedMediaItem.DisplayName}" />
                            <TextBlock Grid.Column="1"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedMediaItem.CropWindowLabel}" />
                        </Grid>

                        <ScrollViewer Grid.Row="3"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding MediaItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,14,0"
                                                Click="ImageTileButton_Click"
                                                Style="{StaticResource EditorTileButtonStyle}"
                                                Tag="{Binding}">
                                            <Border Width="132"
                                                    Height="132"
                                                    Background="#2B2B2B"
                                                    CornerRadius="4">
                                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource FileImageSourceConverter}}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <ScrollViewer Visibility="{Binding IsAudioOverviewVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MediaItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,18,18"
                                            Click="AudioTileButton_Click"
                                            Style="{StaticResource EditorTileButtonStyle}"
                                            Tag="{Binding}">
                                        <Border Width="182"
                                                Height="182"
                                                Background="White"
                                                CornerRadius="2">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Visibility="{Binding IsAudioTrimVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <MediaElement x:Name="AudioPreviewElement"
                                      Width="0"
                                      Height="0"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      MediaEnded="AudioPreviewElement_MediaEnded"
                                      MediaFailed="AudioPreviewElement_MediaFailed"
                                      MediaOpened="AudioPreviewElement_MediaOpened"
                                      Opacity="0"
                                      IsHitTestVisible="False" />

                        <StackPanel Grid.Row="0"
                                    Margin="0,0,0,10"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Margin="0,0,20,0"
                                    Click="CancelTrimButton_Click"
                                    Content="RESET"
                                    Style="{StaticResource GhostButtonStyle}" />
                            <Button Click="DoneTrimButton_Click"
                                    Content="DONE"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Style="{StaticResource GhostButtonStyle}" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Height="360"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="8">
                            <Grid Margin="14">
                                <Image Margin="40,18"
                                       Source="{Binding SelectedMediaItem.PreviewPath, Converter={StaticResource FileImageSourceConverter}}"
                                       Stretch="Fill" />
                                <controls:TrimSelector Margin="40,18"
                                                       PlayheadRatio="{Binding SelectedMediaItem.PreviewStartRatio, Mode=TwoWay}"
                                                       EndRatio="{Binding SelectedMediaItem.TrimEndRatio, Mode=TwoWay}"
                                                       StartRatio="{Binding SelectedMediaItem.TrimStartRatio, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2"
                              Margin="0,18,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Click="AudioPreviewPlayButton_Click"
                                    Content="{Binding AudioPlayButtonText}"
                                    FocusVisualStyle="{x:Null}"
                                    Focusable="False"
                                    FontSize="30"
                                    Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Grid.Column="1"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedMediaItem.DisplayName}" />
                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Right">
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Right"
                                           Text="{Binding SelectedMediaItem.TrimWindowLabel}" />
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Right"
                                           Text="{Binding SelectedMediaItem.PreviewStartLabel}" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="3"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding MediaItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,14,0"
                                                Click="AudioTileButton_Click"
                                                Style="{StaticResource EditorTileButtonStyle}"
                                                Tag="{Binding}">
                                            <Border Width="132"
                                                    Height="132"
                                                    Background="White"
                                                    CornerRadius="2">
                                                <TextBlock Margin="10"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding DisplayName}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <ScrollViewer Visibility="{Binding IsVideoOverviewVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MediaItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,18,18"
                                            Click="VideoTileButton_Click"
                                            Style="{StaticResource EditorTileButtonStyle}"
                                            Tag="{Binding}">
                                        <Border Width="256"
                                                Height="156"
                                                Background="#2B2B2B"
                                                CornerRadius="4">
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource FileImageSourceConverter}}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Visibility="{Binding IsVideoTrimVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Margin="0,0,14,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Text="SET SPEED" />

                                <Button Click="VideoSpeedButton_Click"
                                        Content="x0.5"
                                        Tag="0.5">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource SpeedChipButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedMediaItem.PlaybackSpeedOptionLabel}"
                                                             Value="x0.5">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryTextBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WindowBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Click="VideoSpeedButton_Click"
                                        Content="x1"
                                        Tag="1">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource SpeedChipButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedMediaItem.PlaybackSpeedOptionLabel}"
                                                             Value="x1">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryTextBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WindowBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Click="VideoSpeedButton_Click"
                                        Content="x2"
                                        Tag="2">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource SpeedChipButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedMediaItem.PlaybackSpeedOptionLabel}"
                                                             Value="x2">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryTextBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WindowBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Click="VideoLoopButton_Click"
                                        Content="{Binding VideoLoopButtonText}">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource SpeedChipButtonStyle}">
                                            <Setter Property="MinWidth" Value="94" />
                                            <Setter Property="Margin" Value="18,0,0,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVideoPreviewLoopEnabled}"
                                                             Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryTextBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WindowBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Margin="0,0,20,0"
                                        Click="CancelTrimButton_Click"
                                        Content="RESET"
                                        Style="{StaticResource GhostButtonStyle}" />
                                <Button Click="DoneTrimButton_Click"
                                        Content="DONE"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Style="{StaticResource GhostButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Height="396"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                CornerRadius="8">
                            <Grid Margin="14">
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="{Binding SelectedMediaItem.EditorCanvasWidth}"
                                          Height="{Binding SelectedMediaItem.EditorCanvasHeight}">
                                        <MediaElement x:Name="PreviewMediaElement"
                                                      LoadedBehavior="Manual"
                                                      UnloadedBehavior="Manual"
                                                      ScrubbingEnabled="True"
                                                      Stretch="Fill"
                                                      MediaEnded="PreviewMediaElement_MediaEnded"
                                                      MediaFailed="PreviewMediaElement_MediaFailed"
                                                      MediaOpened="PreviewMediaElement_MediaOpened" />
                                        <Image Source="{Binding SelectedMediaItem.PreviewPath, Converter={StaticResource FileImageSourceConverter}}"
                                               Stretch="Fill"
                                               Visibility="{Binding IsVideoPreviewFallbackVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <controls:CropSelector BottomRatio="{Binding SelectedMediaItem.CropBottomRatio, Mode=TwoWay}"
                                                               LeftRatio="{Binding SelectedMediaItem.CropLeftRatio, Mode=TwoWay}"
                                                               RightRatio="{Binding SelectedMediaItem.CropRightRatio, Mode=TwoWay}"
                                                               TopRatio="{Binding SelectedMediaItem.CropTopRatio, Mode=TwoWay}" />
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="2"
                                   Margin="0,14,0,10"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedMediaItem.TrimWindowLabel}" />

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Click="PreviewPlayButton_Click"
                                    FontSize="30"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Content="{Binding VideoPlayButtonText}" />

                            <Border Grid.Column="1"
                                    Height="130"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    CornerRadius="8">
                                <Grid Margin="14">
                                    <ItemsControl ItemsSource="{Binding SelectedMediaItem.TimelineFrames}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"
                                                             Columns="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="4,0"
                                                        Background="#2B2B2B">
                                                    <Image Source="{Binding Converter={StaticResource FileImageSourceConverter}}"
                                                           Stretch="UniformToFill" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <controls:TrimSelector Margin="16,10"
                                                           PlayheadRatio="{Binding SelectedMediaItem.PreviewStartRatio, Mode=TwoWay}"
                                                           EndRatio="{Binding SelectedMediaItem.TrimEndRatio, Mode=TwoWay}"
                                                           StartRatio="{Binding SelectedMediaItem.TrimStartRatio, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <ScrollViewer Visibility="{Binding IsPdfOverviewVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MediaItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="224"
                                            Height="316"
                                            Margin="0,0,18,18"
                                            Padding="10"
                                            Background="#F3F3F3"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Background="White"
                                                    BorderBrush="#D8D8D8"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource FileImageSourceConverter}}"
                                                       Stretch="Uniform" />
                                            </Border>

                                            <StackPanel Grid.Row="1"
                                                        Margin="0,12,0,0">
                                                <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding DisplayName}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Text="{Binding PageCountLabel}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>

        <Grid Grid.RowSpan="2"
              IsHitTestVisible="False"
              Panel.ZIndex="9">
            <Border x:Name="ToastNotificationBorder"
                    MaxWidth="520"
                    Margin="0,0,34,28"
                    Padding="18,14"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#E61F1F1F"
                    BorderBrush="#5A5A5A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Opacity="1"
                    Visibility="{Binding HasToastMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="{Binding ToastMessage}"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>

        <Grid Grid.RowSpan="2"
              Visibility="{Binding IsOptionsOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="10">
            <Border Background="#BA000000" />
            <Border Width="700"
                    MaxHeight="690"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontFamily="Arial Black"
                                   FontSize="34"
                                   Text="OPTIONS" />

                        <StackPanel Grid.Column="1"
                                    Width="220"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Text="{Binding AppVersion}" />
                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Right"
                                       Text="{Binding AppDisplayCreditLine}"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,24,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Text="DEFAULT EXPORT PATH" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Height="42"
                                             Padding="12,10"
                                             BorderThickness="1"
                                             Style="{StaticResource DarkTextBoxStyle}"
                                             Text="{Binding DefaultExportPathDraft, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Background="#F2F2F2"
                                            BorderBrush="Transparent"
                                            Click="BrowseDefaultExportPathButton_Click"
                                            Content="BROWSE"
                                            FontWeight="Bold" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,22,0,0">
                                <CheckBox FontSize="17"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          IsChecked="{Binding CreateDateFoldersDraft}"
                                          Content="Automatically create folders based on date" />

                                <CheckBox Margin="0,12,0,0"
                                          FontSize="17"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          IsChecked="{Binding OpenExportFolderAfterExportDraft}"
                                          Content="Automatically open exported folder after export" />

                                <CheckBox Margin="0,12,0,0"
                                          FontSize="17"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          IsChecked="{Binding ReturnHomeAfterExportDraft}"
                                          Content="Jump back home after export" />

                                <CheckBox Margin="0,12,0,0"
                                          FontSize="17"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          IsChecked="{Binding RemoveMetadataDraft}"
                                          Content="Remove metadata from exported files" />
                            </StackPanel>

                            <StackPanel Margin="0,22,0,0">
                                <CheckBox FontSize="17"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          IsChecked="{Binding AddCustomSuffixDraft}"
                                          Content="Add custom suffix to files" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="14"
                                           Text="CUSTOM SUFFIX" />
                                <TextBox Margin="0,8,0,0"
                                         Height="42"
                                         Padding="12,10"
                                         BorderThickness="1"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         IsEnabled="{Binding AddCustomSuffixDraft}"
                                         Text="{Binding CustomSuffixDraft, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Border Margin="0,22,0,0"
                                    Padding="18"
                                    Background="{DynamicResource SurfaceBackgroundBrush}"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Text="DEFAULT MEDIA SETTINGS" />

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Text="DEFAULT IMAGE COMPRESSION" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Text="{Binding DefaultImageCompressionDraftLabel}" />
                                    </Grid>
                                    <Slider Margin="0,8,0,0"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="5"
                                            Value="{Binding DefaultImageCompressionDraft}" />

                                    <TextBlock Margin="0,18,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Text="DEFAULT IMAGE EXPORT FORMAT" />
                                    <ComboBox Margin="0,10,0,0"
                                              ItemsSource="{Binding ImageFormatOptions}"
                                              SelectedItem="{Binding DefaultImageFormatDraft}"
                                              Style="{StaticResource DarkComboBoxStyle}" />

                                    <TextBlock Margin="0,18,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Text="DEFAULT AUDIO EXPORT FORMAT" />
                                    <ComboBox Margin="0,10,0,0"
                                              ItemsSource="{Binding AudioFormatOptions}"
                                              SelectedItem="{Binding DefaultAudioFormatDraft}"
                                              Style="{StaticResource DarkComboBoxStyle}" />

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Text="DEFAULT LOWER VIDEO RESOLUTION" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Text="{Binding DefaultVideoResolutionDraftLabel}" />
                                    </Grid>
                                    <Slider Margin="0,8,0,0"
                                            Minimum="1"
                                            Maximum="4"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding DefaultVideoResolutionDraft}" />

                                    <TextBlock Margin="0,18,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Text="DEFAULT VIDEO EXPORT FORMAT" />
                                    <ComboBox Margin="0,10,0,0"
                                              ItemsSource="{Binding VideoFormatOptions}"
                                              SelectedItem="{Binding DefaultVideoFormatDraft}"
                                              Style="{StaticResource DarkComboBoxStyle}" />

                                    <CheckBox Margin="0,14,0,0"
                                              FontSize="17"
                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                              IsChecked="{Binding DefaultVideoPreviewLoopDraft}"
                                              Content="Loop video preview by default" />

                                    <TextBlock Margin="0,18,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Text="DEFAULT PDF CONVERT / MODIFY" />
                                    <ComboBox Margin="0,10,0,0"
                                              DisplayMemberPath="Label"
                                              ItemsSource="{Binding DefaultPdfActionOptions}"
                                              SelectedItem="{Binding DefaultPdfActionDraft}"
                                              Style="{StaticResource DarkComboBoxStyle}" />

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Text="DEFAULT WINDOW SIZE" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Text="{Binding DefaultWindowScaleDraftLabel}" />
                                    </Grid>
                                    <Slider Margin="0,8,0,0"
                                            Minimum="66"
                                            Maximum="120"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding DefaultWindowScaleDraft}" />

                                    <TextBlock Margin="0,22,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Text="THEME TEXT COLOR" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="42"
                                                Height="42"
                                                VerticalAlignment="Center"
                                                Background="{Binding ThemeColorPreviewBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4" />

                                        <TextBox Grid.Column="1"
                                                 Margin="12,0,0,0"
                                                 Height="42"
                                                 Padding="12,10"
                                                 BorderThickness="1"
                                                 Style="{StaticResource DarkTextBoxStyle}"
                                                 Text="{Binding ThemeTextColorHexDraft, UpdateSourceTrigger=PropertyChanged}" />

                                        <Button Grid.Column="2"
                                                Margin="12,0,0,0"
                                                Click="ResetThemeColorButton_Click"
                                                Content="RESET TO DEFAULT"
                                                Style="{StaticResource DialogSecondaryButtonStyle}" />
                                    </Grid>

                                    <TextBlock Margin="0,18,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Text="THEME BACKGROUND COLOR" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="42"
                                                Height="42"
                                                VerticalAlignment="Center"
                                                Background="{Binding ThemeBackgroundPreviewBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4" />

                                        <TextBox Grid.Column="1"
                                                 Margin="12,0,0,0"
                                                 Height="42"
                                                 Padding="12,10"
                                                 BorderThickness="1"
                                                 Style="{StaticResource DarkTextBoxStyle}"
                                                 Text="{Binding ThemeBackgroundColorHexDraft, UpdateSourceTrigger=PropertyChanged}" />

                                        <Button Grid.Column="2"
                                                Margin="12,0,0,0"
                                                Click="ResetThemeBackgroundColorButton_Click"
                                                Content="RESET TO DEFAULT"
                                                Style="{StaticResource DialogSecondaryButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,22,0,0"
                                    Padding="16"
                                    Background="{DynamicResource PreviewBackgroundBrush}"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="14"
                                               Text="EXPORT PREVIEW" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="15"
                                               Text="{Binding OptionsPreviewPath}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Margin="0,24,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Margin="0,0,12,0"
                                Click="CancelOptionsButton_Click"
                                Content="CANCEL"
                                Style="{StaticResource DialogSecondaryButtonStyle}" />
                        <Button Padding="18,12"
                                Click="SaveOptionsButton_Click"
                                Content="SAVE"
                                Style="{StaticResource DialogPrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="2"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="12">
            <Border Background="#B4000000" />
            <Border Width="380"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="26"
                               FontWeight="Bold"
                               Text="{Binding BusyMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="15"
                               Text="{Binding BusyDetailMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasBusyDetailMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ProgressBar Height="10"
                                 Margin="0,24,0,0"
                                 Maximum="{Binding BusyProgressMaximum}"
                                 Minimum="0"
                                 Value="{Binding BusyProgressValue}"
                                 IsIndeterminate="{Binding IsBusyProgressIndeterminate}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
        </Viewbox>
    </Grid>
</Window>



